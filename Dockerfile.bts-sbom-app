# BTS-SBOM chatbot / API service (stdlib only; the bts_sbom core is part of this repository, so there is nothing else to install).
# BUILT AND MEASURED (2026-11-22): `docker build` completed in 50.61 s and the running container reached
# `/readyz` 200 + HEALTHCHECK `healthy` (FailingStreak 0); Trivy found 0 CRITICAL. Full evidence:
# `python scripts/supply_chain_gate.py` -> evidence/supply_chain/ and docs/RUNBOOK.md "Delivery State".
# The static policy tests in tests/bts_sbom_app/test_container_policy.py read this file's text only.
# Build:  docker build -f Dockerfile.bts-sbom-app -t bts-sbom-app .
# Run:    docker run --rm -p 127.0.0.1:8800:8800 -e EXAONE_API_KEY=... bts-sbom-app
# The service binds 0.0.0.0 inside the container; publish the port on localhost only (as above) - it has NO authentication.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY bts_sbom ./bts_sbom
COPY bts_sbom_app ./bts_sbom_app
COPY knowledge ./knowledge
COPY evals ./evals
RUN pip install --no-cache-dir --no-deps .
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1
EXPOSE 8800
# Non-root, numeric UID (no /etc/passwd entry needed): GET /readyz checks the evidence folder is writable, so it must
# exist and be owned by this UID before the switch - /app itself stays owned by root (world-readable is enough to run it).
RUN mkdir -p /tmp/evidence && chown -R 10001:10001 /tmp/evidence
# The LLM call ledger resolves to <root>/evidence/.llm_ledger.json (/app/evidence) by design - independent of which
# --evidence folder the service was started with. In the container /app is read-only for this UID, so that folder
# must exist and be writable (the ledger is a per-day counter: ephemeral here, the durable state lives on the
# evidence volume). MEASURED ON AZURE 2026-11-23: without this line every chat turn 503s at llm._bump.
RUN mkdir -p /app/evidence && chown -R 10001:10001 /app/evidence
USER 10001
# urllib is stdlib (no curl in the image to keep it minimal); failure is "not ready", which docker reports as unhealthy,
# not "process is down" - the process itself may be fine while a dependency (e.g. the evidence volume) is not.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-c", "import sys,urllib.request as u; sys.exit(0 if u.urlopen('http://127.0.0.1:8800/readyz', timeout=2).status == 200 else 1)"]
CMD ["python", "-m", "bts_sbom_app", "--root", "/app", "serve", "--host", "0.0.0.0", "--port", "8800", "--evidence", "/tmp/evidence"]
